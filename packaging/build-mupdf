#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
work=$(mktemp -d /tmp/paperwork-linux-mupdf.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT
./packaging/prepare-mupdf "$work"
src="$work/mupdf-1.28.6-source"
make -C "$src" -j"${PAPERWORK_NATIVE_JOBS:-6}" build=release shared=yes \
    USE_SYSTEM_LIBS=no HAVE_LIBCRYPTO=no HAVE_X11=no HAVE_GLUT=no HAVE_CURL=no \
    XCFLAGS='-DTOFU_CJK_EXT -D_FORTIFY_SOURCE=2 -fstack-protector-strong' \
    XLIB_LDFLAGS='-Wl,-z,relro,-z,now' libs
library=$(find "$src/build" -type f -name libmupdf.so.28.6 -print -quit)
test -n "$library"
install -D -m 0644 "$library" .runtime/mupdf-1.28.6-paperwork/libmupdf.so.28.6
