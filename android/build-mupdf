#!/bin/sh
set -eu
cd "$(dirname "$0")"

platform=${PAPERWORK_PLATFORM_JAR:-.work/platform/android-35/android.jar}
ndk=${PAPERWORK_NDK:-${ANDROID_HOME:-}/ndk/28.2.13676358}
if [ ! -f "$platform" ] || [ ! -x "$ndk/ndk-build" ]; then
    printf '%s\n' 'Set PAPERWORK_PLATFORM_JAR and PAPERWORK_NDK. See docs/build.md.' >&2
    exit 1
fi
platform=$(realpath "$platform")
ndk=$(realpath "$ndk")

# ndk-build requires a source path without spaces.
work=$(mktemp -d /tmp/paperwork-mupdf.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT
../packaging/prepare-mupdf "$work"
src="$work/mupdf-1.28.6-source"
mkdir "$work/classes" "$work/libs"
find "$src/platform/java/src" -name '*.java' > "$work/java-sources"
javac -encoding UTF-8 -source 11 -target 11 -Xlint:-options -cp "$platform" -d "$work/classes" @"$work/java-sources"
(
    cd "$src"
    "$ndk/ndk-build" -j"${PAPERWORK_NATIVE_JOBS:-6}" \
        NDK_PROJECT_PATH="$src" APP_BUILD_SCRIPT="$src/platform/java/Android.mk" \
        NDK_OUT="$work/obj" NDK_LIBS_OUT="$work/libs" APP_PLATFORM=android-21 APP_OPTIM=release \
        'APP_ABI=arm64-v8a armeabi-v7a x86 x86_64'
)
out=.work/mupdf-1.28.6-paperwork
mkdir -p "$out"
cp -r "$work/libs" "$out/"
cp "$src/COPYING" "$out/COPYING"
jar --create --file "$out/fitz.jar" -C "$work/classes" .
